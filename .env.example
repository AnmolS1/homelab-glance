# homelab-glance — copy to .env and fill in your values
#
# ONLY WIDGET_TOKEN is required. Everything else is opt-in:
#   • service pollers (Beszel/Jellyfin/…) upgrade generic cards to rich cards
#   • the Docker control-plane vars enable start/stop/restart from the app
# See aggregator/README.md for the full guide.

# ── Beszel hub (PocketBase) — optional rich poller ───────────────────────────
# Create a dedicated read-only user in the Beszel hub admin UI, then fill in:
# NOTE: BESZEL_USER must be the account's email address, not a username.
BESZEL_URL=http://YOUR_SERVER_IP:8090
BESZEL_USER=you@example.com
BESZEL_PASSWORD=change_me

# ── Jellyfin ──────────────────────────────────────────────────────────────────
JELLYFIN_URL=http://YOUR_SERVER_IP:8096
JELLYFIN_KEY=your_jellyfin_api_key

# ── qBittorrent (exposed via gluetun, host port 8080) ────────────────────────
QBIT_URL=http://YOUR_SERVER_IP:8080
QBIT_USERNAME=your_qbit_username
QBIT_PASSWORD=change_me

# ── Pi-hole v6 (host-network, webserver port 8880) ───────────────────────────
PIHOLE_URL=http://YOUR_SERVER_IP:8880
PIHOLE_WEBUI_PASSWORD=change_me

# ── Sonarr ────────────────────────────────────────────────────────────────────
SONARR_URL=http://YOUR_SERVER_IP:8989
SONARR_API_KEY=your_sonarr_api_key

# ── Radarr ────────────────────────────────────────────────────────────────────
RADARR_URL=http://YOUR_SERVER_IP:7878
RADARR_API_KEY=your_radarr_api_key

# ── Prowlarr ──────────────────────────────────────────────────────────────────
PROWLARR_URL=http://YOUR_SERVER_IP:9696
PROWLARR_API_KEY=your_prowlarr_api_key

# ── Aggregator ────────────────────────────────────────────────────────────────
POLL_SECONDS=15

# Generate with:  openssl rand -hex 32
WIDGET_TOKEN=change_me

# ── Docker control plane (optional) ──────────────────────────────────────────
# Replaces Portainer for day-to-day start/stop/restart from the native app.
# Leave DOCKER_PROXY_URL empty to disable the control endpoints entirely.
#
# Point at your existing tecnativa/docker-socket-proxy. For writes the proxy
# needs CONTAINERS=1 and POST=1; keep EXEC=0 (no in-container shell).
DOCKER_PROXY_URL=
# Separate, stricter token required for writes (start/stop/restart).
# Generate with:  openssl rand -hex 32 — treat it like a root password.
CONTROL_TOKEN=
# Optional: if set, ONLY these container names may be controlled (comma-sep).
# If empty, all are controllable EXCEPT the protected set below.
DOCKER_CONTROL_ALLOWLIST=
# Never controllable, regardless of allowlist (don't let it stop its own plumbing).
DOCKER_PROTECTED=dockerproxy,caddy,cloudflared,glance
# Optional file to append a JSON-lines audit record for every write.
AUDIT_LOG_PATH=

# ── Host tuning (optional) ────────────────────────────────────────────────────
# Read-only bind mount for data-drive usage reporting (see docker-compose.yml).
EXPANSION_PATH=/host/expansion
# Beszel sensor key names (hardware-specific; check the aggregator logs after
# first startup: `docker compose logs glance | grep "BESZEL raw system_stats"`).
NVME_TEMP_SENSOR=nvme_composite
GPU_TEMP_SENSOR=amdgpu_edge
TEMP_HISTORY_LEN=30
