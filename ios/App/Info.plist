<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Homelab Glance</string>
	<!-- Required by the Mac App Store. INFOPLIST_KEY_LSApplicationCategoryType
	     in build settings is ignored because GENERATE_INFOPLIST_FILE = NO, so
	     the key must live here directly. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Custom URL scheme so widget cards can deep-link into the app (e.g.
	     homelabglance://logs/<container>). Handled by onOpenURL in HomelabGlanceApp. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>dev.ponderance.homelabglance</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>homelabglance</string>
			</array>
		</dict>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Connecting to a LAN/Tailscale server triggers the iOS local-network
	     prompt; this string explains why. The first connection attempt (not app
	     launch) is what surfaces the prompt. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Homelab Glance connects to your aggregator server on your local network to show service status and control containers.</string>
	<!-- Standard HTTPS only — export-compliance exempt. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Posture: require HTTPS by default. NSAllowsLocalNetworking permits
		     cleartext to RFC-1918/.local hosts (a user's LAN server) without a
		     global exception; the ts.net entry additionally allows plain HTTP to
		     Tailscale MagicDNS hosts, which ride the encrypted WireGuard tunnel
		     (ts.net is public DNS, so NSAllowsLocalNetworking doesn't cover it).
		     Never NSAllowsArbitraryLoads. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>ts.net</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
