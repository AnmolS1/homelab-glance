# homelab-glance Übersicht widget secrets
# Copy this file to $HOME/.config/homelab-glance/secrets.env and fill in your values.
# That path is outside this repo and will never be committed.
#
# Setup:
#   mkdir -p ~/.config/homelab-glance
#   cp ubersicht/glance.secrets.env.example ~/.config/homelab-glance/secrets.env
#   $EDITOR ~/.config/homelab-glance/secrets.env

# Bearer token — must match WIDGET_TOKEN in your server .env
# Generate with: openssl rand -hex 32
WIDGET_TOKEN=change_me

# Aggregator URL — replace YOUR_SERVER_IP with your server's IP or Tailscale IP
AGGREGATOR_URL=http://YOUR_SERVER_IP:8765/api/dashboard
